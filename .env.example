# Used only by a directly started host-development process with
# config-development-host.json. Controller-managed Podman and production
# instances receive UNS_SERVICE_TOKEN_FILE automatically.
UNS_SERVICE_TOKEN=replace-with-development-machine-token

# The profiles resolve this name from the runtime environment for QuestDB HTTP
# Basic Auth. Set it in .env only for host development. For controller-managed
# Podman or production, provide it through the controller environment or its
# approved secret provider; never add it to the instance config file.
QUESTDB_PASSWORD=quest

# Required for direct host development so API route metadata identifies the
# local controller. Controller-managed instances receive these values from PM2.
UNS_CONTROLLER_NAME=controller-local
UNS_CONTROLLER_PUBLIC_BASE=http://localhost:3200

# Optional local alternative to JWKS validation:
# UNS_API_JWT_SECRET=change-me
